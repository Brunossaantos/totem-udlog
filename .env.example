# =============================================================================
# .env.example - modelo de configuracao do totem-udlog
#
# Copie para `.env` (nunca versionado, permissao 600, FORA da pasta publica) e
# preencha. Todos os valores abaixo sao FICTICIOS/seguros: hosts "exemplo.invalid"
# nao resolvem, chaves vazias ficam vazias ate o preenchimento real, e a
# integracao com o Talent vem DESLIGADA. Nunca coloque credencial, token ou dado
# pessoal neste arquivo.
#
# Gerar segredo hex de 64 caracteres (executar no proprio servidor):
#   php -r "echo bin2hex(random_bytes(32));"
#
# O arquivo e lido por vlucas/phpdotenv (Dotenv::createImmutable): uma variavel
# ja definida no ambiente do processo prevalece sobre o valor do arquivo.
# =============================================================================


# =============================================================================
# OBRIGATORIAS - a aplicacao nao sobe (ou a funcionalidade indicada falha
# fechada) sem elas
# =============================================================================

# --- Banco do totem (obrigatorias: DB_HOST, DB_NAME, DB_USER, DB_PASS) -------
# Em producao o nome do banco e o usuario levam o prefixo da conta cPanel.
DB_HOST=localhost
DB_NAME=udlog_totem
DB_USER=
DB_PASS=

# --- Banco externo de gestao de coletas --------------------------------------
# MESMO servidor e MESMA credencial acima (DB_HOST/DB_PORT/DB_USER/DB_PASS); so o
# nome do banco muda. Conexao PDO propria (Util\ConexaoGestaoColetas), usada na
# consulta/baixa de Ordem de Coleta (Expedicao), nos anexos da OC e na tela de
# Ordens da gestao. Vazio = essas funcoes falham.
GESTAO_COLETAS_DB_NAME=

# --- Storage ------------------------------------------------------------------
# Raiz de armazenamento (fotos de notas, anexos de OC, rate limit da pagina do
# totem, throttle de logs, tmp). OBRIGATORIAMENTE fora do public_html/docroot e
# gravavel pelo usuario do PHP (web e cron).
STORAGE_PATH=/home/SEU_USUARIO_CPANEL/storage/atendimentos

# --- Gestao Totem (/gestao) ---------------------------------------------------
# GESTAO_HASH_SALT: SEGREDO, minimo 16 caracteres (recomendado 64 hex). Sal do
# balde de IP do limite de login, do token CSRF do formulario de login e do
# rate limit da pagina do totem. Ausente/curto = a gestao responde 503.
# Trocar o valor zera os contadores de IP e invalida formularios de login
# abertos (sessoes ja abertas nao sao afetadas). Defina SO no servidor.
GESTAO_HASH_SALT=

# TOTEM_URL_BASE: URL base do quiosque, usada so para a gestao montar a URL
# <TOTEM_URL_BASE>?totem=NOME-EMPRESA-HASH16. Obrigatoria para a tela Totens
# (ausente/invalida = 503). http ou https, sem espaco, sem query, TERMINA em "/".
# Nunca e derivada do cabecalho Host. Troque pelo dominio real do ambiente.
TOTEM_URL_BASE=https://totem.exemplo.invalid/totem/

# --- Talent (Portaria/Checkin) ------------------------------------------------
# TALENT_API_URL e a BASE URL (sem o endpoint): o cliente acrescenta
# "/Portaria/Checkin". TALENT_API_KEY e o token Bearer; nunca logado.
# Obrigatorias para o check-in real.
TALENT_API_URL=https://talent.exemplo.invalid
TALENT_API_KEY=

# --- vio.api.br (leitura/validacao de CNH e CRLV por QR) ---------------------
# VIO_API_BR_BASE_URL: base HTTPS (o cliente recusa vazio ou nao-HTTPS).
# VIO_API_BR_API_KEY: enviada no header X-API-Key; nunca logada nem exposta ao
# front-end. Obrigatorias para validar documentos.
VIO_API_BR_BASE_URL=https://vio.exemplo.invalid
VIO_API_BR_API_KEY=

# --- Servico local de impressao (mini PC do totem) ---------------------------
# Servico Node em 127.0.0.1 do mini PC (servico-impressao-local/). A URL e local,
# nunca um endereco publico. IMPRESSAO_LOCAL_TOKEN e o MESMO valor do campo
# "token" de config/config.json do servico (copia manual, sem sincronizacao
# automatica). IMPRESSAO_FRONTEND_TIMEOUT_MS (numerico > 0) e devolvido ao
# front-end e deve ser MAIOR que "timeoutMs" do config.json do servico.
# Obrigatorias para imprimir.
# Lista de impressoras permitidas, timeout do job e origens CORS vivem so no
# config.json do servico; o PHP nao le essas configuracoes do .env.
IMPRESSAO_LOCAL_URL=http://127.0.0.1:4747
IMPRESSAO_LOCAL_TOKEN=
IMPRESSAO_FRONTEND_TIMEOUT_MS=35000

# --- Etiqueta (as 4 sao obrigatorias; ausente/invalida = erro 500) -----------
# Papel em milimetros, orientacao (portrait|landscape) e corte (true|false).
# Configuracao decidida: papel 80x80 mm retrato (papel "totem" do driver EPSON).
ETIQUETA_LARGURA_MM=80
ETIQUETA_COMPRIMENTO_MM=80
ETIQUETA_ORIENTACAO=portrait
ETIQUETA_CORTE_APOS_IMPRESSAO=true

# --- Anexo da Ordem de Coleta enviado pelo n8n -------------------------------
# Rota server-to-server public/api/ordem-coleta-anexo.php. SEGREDO enviado pelo
# n8n em "Authorization: Bearer <chave>"; nunca reaproveitar outro token.
# Ausente/vazia = a rota responde 503 (fail-closed). Em caso de exposicao,
# rotacionar no .env e no n8n ao mesmo tempo.
ORDEM_COLETA_ANEXO_API_KEY=


# =============================================================================
# OPCIONAIS - tem padrao no codigo; descomente/ajuste so se necessario
# =============================================================================

# Porta do MySQL (padrao 3306).
DB_PORT=3306

# Tamanho maximo, em BYTES, do binario decodificado de imagens enviadas em
# base64 (validado apos o base64_decode). Padrao 5242880 (5 MB).
NOTA_IMAGEM_MAX_BYTES=5242880

# Ativacao do check-in real no Talent (fail-closed): SO o valor literal "true"
# liga. Ausente, vazio ou qualquer outro valor = desativado (a finalizacao passa
# pelos gates mas responde 503 TALENT_CHECKIN_DESATIVADO e nunca chama o Talent).
TALENT_CHECKIN_ATIVO=false

# Exige numero valido em todas as notas ativas ao concluir a digitalizacao (HTTP
# 422 NOTAS_SEM_NUMERO). SO o literal "true" liga; padrao desligado. Ligar so com
# o front-end atual no ar.
CONCLUIR_EXIGE_NUMERO_NOTA=false

# Largura util do CONTEUDO da etiqueta em mm, a partir de 1 mm da borda esquerda
# (a EPSON TM-T88VII imprime ~50,8 mm). Entre 20 e a largura da pagina;
# ausente/invalido = 48. Nao altera o tamanho da pagina.
# ETIQUETA_AREA_UTIL_MM=48

# Tamanho maximo, em BYTES, do PDF DECODIFICADO do anexo da OC. Padrao 5242880.
ORDEM_COLETA_ANEXO_MAX_BYTES=5242880

# Sessao da gestao: minutos de inatividade (padrao 30, faixa 1..1440) e teto
# absoluto em minutos (padrao 720, faixa 1..10080). Fora da faixa = padrao.
GESTAO_SESSION_IDLE_MIN=30
GESTAO_SESSION_ABSOLUTE_MIN=720

# Chave AES-256-GCM (hex, 64 caracteres = 32 bytes) lida por Util\CriptografiaHelper,
# usada so pelo cache de CNH/CRLV (App\Dao\VioCacheDao). No fluxo atual de CNH/CRLV
# (QR) esse cache nao e consultado; mantida por compatibilidade com esse codigo.
DOCUMENTO_DATA_KEY=

# (SOMENTE desenvolvimento local, sem HTTPS) Em producao NAO definir: ausente =
# HTTPS obrigatorio. So o literal "true" libera HTTP.
# GESTAO_PERMITIR_HTTP=true
# ORDEM_COLETA_ANEXO_PERMITIR_HTTP=true

# Observacao: o servico de impressao do mini PC (Node) NAO le este arquivo. Ele
# usa servico-impressao-local/config/config.json (nao versionado; modelo em
# config.example.json) e, opcionalmente, a variavel de processo CONFIG_PATH com
# o caminho alternativo desse arquivo.
