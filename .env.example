DB_HOST=localhost
DB_NAME=udlog_totem
DB_USER=
DB_PASS=
DB_PORT=3306

# Banco externo de gestao de coletas — MESMO servidor/credencial acima
# (DB_HOST/DB_PORT/DB_USER/DB_PASS), so o nome do banco muda. Usado por
# Util\ConexaoGestaoColetas (conexao PDO propria, nunca compartilhada com
# Util\Conexao) para consultar tb_ordens_coleta/tb_clientes diretamente
# (demanda expedicao-consulta-ordem-coleta-teste, 2026-09-11 — nunca existiu
# API REST real documentada para essa consulta). Sem valor real aqui de
# proposito (nome do banco em producao depende do prefixo cPanel).
GESTAO_COLETAS_DB_NAME=

STORAGE_PATH=/home/SEU_USUARIO_CPANEL/storage/atendimentos

# Tamanho maximo, em BYTES, aceito para o binario decodificado de imagens
# de nota fiscal/CNH/CRLV enviadas em base64 pelo totem (validado apos o
# base64_decode, nao antes). Valor padrao: 5242880 bytes = 5 MB. Se a
# variavel nao estiver definida, o codigo usa esse mesmo padrao de 5 MB.
NOTA_IMAGEM_MAX_BYTES=5242880

# Talent (Portaria/Checkin) — TALENT_API_URL e a BASE URL (ex:
# https://api.talentcs.com.br), NAO o endpoint completo — App\Rn\TalentClient
# apenda "/Portaria/Checkin" por conta propria. TALENT_API_KEY e o token
# Bearer (Authorization: Bearer <token>), NUNCA logado/persistido em texto
# claro. Ver docs/manual_talent.md.
TALENT_API_URL=
TALENT_API_KEY=

PRODESP_API_URL=https://api.prodesp.sp.gov.br/portaldeapis/
PRODESP_API_KEY=

# VIO Decode (Serpro) — validacao de CNH/CRLV via QR Code na Expedicao.
# VIO_AMBIENTE decide TODO o fluxo de autenticacao/URL (trial|production) —
# fail-closed se ausente/invalido, nunca assume um dos dois por default.
# Trial usa VIO_TRIAL_BEARER direto (Bearer publico do Swagger oficial, NUNCA
# commitar o valor real). Producao usa VIO_CONSUMER_KEY/VIO_CONSUMER_SECRET
# via OAuth2 client_credentials (HTTP Basic) contra VIO_TOKEN_URL.
VIO_AMBIENTE=trial
VIO_TRIAL_BEARER=
VIO_TRIAL_DECODE_URL=https://gateway.apiserpro.serpro.gov.br/viodec-trial/v1/decode
VIO_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token
VIO_CONSUMER_KEY=
VIO_CONSUMER_SECRET=
VIO_PRODUCAO_DECODE_URL=https://gateway.apiserpro.serpro.gov.br/viodec/v1/decode
# Dias de validade do cache local de CNH/CRLV ja validados pela VIO Decode
VIO_CACHE_TTL_DIAS=30

# Chave HMAC-SHA256 (hex, 64 chars) usada para gerar o identificador do QR
# (nunca o QR bruto e persistido) e chave AES-256-GCM (hex, 64 chars = 32
# bytes) usada para criptografar nome/CPF em repouso no cache de CNH.
# Gerar com: php -r "echo bin2hex(random_bytes(32));"
DOCUMENTO_QR_HMAC_KEY=
DOCUMENTO_DATA_KEY=

# Servico local de impressao (mini PC Windows do totem, EPSON TM-T88VII via
# USB, demanda impressao-etiqueta-teste, 2026-09-14) — servico Node.js
# implementado a parte (fora do escopo Hostgator/PHP), exposto so em
# 127.0.0.1 no mini PC. IMPRESSAO_LOCAL_URL e a base URL local (ex:
# http://127.0.0.1:PORTA), NUNCA um endereco publico. IMPRESSAO_LOCAL_TOKEN
# e o token compartilhado que o front-end do totem envia ao servico local
# (autenticacao propria, alem de CORS/PNA — recomendacao security-especialista
# no handoff de 00-planejamento), NUNCA commitado com valor real.
# App\Controller\ImpressaoTesteController::configuracaoServicoLocal() devolve
# essas duas variaveis ao front-end so apos Util\Auth::validarTotem().
IMPRESSAO_LOCAL_URL=
IMPRESSAO_LOCAL_TOKEN=

# IMPRESSORAS_PERMITIDAS e IMPRESSAO_TIMEOUT_MS sao espelhos de
# documentacao/operacao dos MESMOS valores configurados manualmente em
# servico-impressao-local/config/config.json no mini PC (campos
# "impressorasPermitidas"/"timeoutMs") -- mesmo padrao de espelhamento
# manual ja usado para o token acima: nao ha conexao viva entre o .env do
# Hostgator e o config.json do mini PC, o PHP nao le estas duas variaveis.
# IMPRESSAO_FRONTEND_TIMEOUT_MS E lida de fato por
# App\Controller\ImpressaoTesteController::configuracaoServicoLocal() e
# devolvida ao front-end (deve ser sempre maior que IMPRESSAO_TIMEOUT_MS/
# timeoutMs do servico local, para o front nao desistir antes do servico
# local ter chance de responder com o resultado do timeout dele).
IMPRESSORAS_PERMITIDAS="EPSON TM-T88VII Receipt"
IMPRESSAO_TIMEOUT_MS=30000
IMPRESSAO_FRONTEND_TIMEOUT_MS=35000

# Etiqueta de teste de impressao (App\Controller\ImpressaoTesteController) —
# largura/comprimento em MILIMETROS, orientacao (portrait|landscape) e corte
# apos impressao (true|false) SEMPRE configuraveis aqui, nunca hardcoded no
# codigo. Valores abaixo confirmados pelo usuario em 2026-09-14 para a
# etiqueta fisica real (50mm x 297mm, retrato, papel termico continuo) — mas
# o proprio endpoint falha (fail-closed) se alguma dessas 4 variaveis estiver
# ausente/invalida, nunca assume um default silencioso.
ETIQUETA_LARGURA_MM=50
ETIQUETA_COMPRIMENTO_MM=297
ETIQUETA_ORIENTACAO=portrait
ETIQUETA_CORTE_APOS_IMPRESSAO=true
