DB_HOST=localhost
DB_NAME=udlog_totem
DB_USER=
DB_PASS=
DB_PORT=3306

# Banco externo de gestao de coletas — MESMO servidor/credencial acima
# (DB_HOST/DB_PORT/DB_USER/DB_PASS), so o nome do banco muda. Usado por
# Util\ConexaoGestaoColetas (conexao PDO propria, nunca compartilhada com
# Util\Conexao) para consultar tb_ordens_coleta/tb_clientes diretamente
# (demanda expedicao-consulta-ordem-coleta-teste, 2026-09-11 — nunca existiu
# API REST real documentada para essa consulta). Sem valor real aqui de
# proposito (nome do banco em producao depende do prefixo cPanel).
GESTAO_COLETAS_DB_NAME=

STORAGE_PATH=/home/SEU_USUARIO_CPANEL/storage/atendimentos

# Tamanho maximo, em BYTES, aceito para o binario decodificado de imagens
# de nota fiscal/CNH/CRLV enviadas em base64 pelo totem (validado apos o
# base64_decode, nao antes). Valor padrao: 5242880 bytes = 5 MB. Se a
# variavel nao estiver definida, o codigo usa esse mesmo padrao de 5 MB.
NOTA_IMAGEM_MAX_BYTES=5242880

# Talent (Portaria/Checkin) — TALENT_API_URL e a BASE URL (ex:
# https://api.talentcs.com.br), NAO o endpoint completo — App\Rn\TalentClient
# apenda "/Portaria/Checkin" por conta propria. TALENT_API_KEY e o token
# Bearer (Authorization: Bearer <token>), NUNCA logado/persistido em texto
# claro. Ver docs/manual_talent.md.
TALENT_API_URL=
TALENT_API_KEY=

# Mecanismo de "ativacao configuravel fail-closed" (demanda
# talent-doctos-finalizacao-checkin, 2026-09-14) — enquanto
# TALENT_CHECKIN_ATIVO nao for LITERALMENTE a string "true",
# App\Controller\AtendimentoController::finalizar() passa por TODOS os gates
# reais (doctos[]/posse/tipo/status/etapa/documentos), mas NUNCA chama o
# Talent de fato (responde 503 TALENT_CHECKIN_DESATIVADO). Ausente, vazio ou
# qualquer outro valor = tratado como desativado (fail-closed). So mudar
# para "true" apos um teste controlado em Producao autorizado
# explicitamente pelo usuario — nunca por decisao automatica de codigo.
TALENT_CHECKIN_ATIVO=false

# VIO Decode (Serpro) — integracao direta antiga com o Serpro/VIO Decode
# REMOVIDA (demanda remocao-legado-serpro-e-hardening-documentos,
# 2026-09-28), junto com Prodesp (App\Rn\ProdespClient, nunca teve
# chamador real) — ver .env.example de versoes anteriores no historico do
# Git se algum dia for necessario reconsultar os nomes das variaveis
# antigas. Substituida integralmente pela vio.api.br (ver abaixo).

# Chave HMAC-SHA256 (hex, 64 chars) usada para gerar o identificador do QR
# (nunca o QR bruto e persistido) e chave AES-256-GCM (hex, 64 chars = 32
# bytes) usada para criptografar nome/CPF em repouso no cache de CNH.
# Gerar com: php -r "echo bin2hex(random_bytes(32));"
DOCUMENTO_QR_HMAC_KEY=
DOCUMENTO_DATA_KEY=

# vio.api.br — SUBSTITUI o USO direto do Serpro/VIO Decode (App\Rn\
# VioDecodeClient removido do repositorio na demanda
# remocao-legado-serpro-e-hardening-documentos, 2026-09-28). Ver
# App\Rn\VioApiBrClient e docs/handoffs/2026-09-25-migracao-vio-api-br-com-cache.md.
#
# VIO_API_BR_BASE_URL: base HTTPS (ex.: https://vio.api.br) — leitura
# fail-closed, RuntimeException imediata se ausente/vazia ou nao-HTTPS.
# VIO_API_BR_API_KEY: token enviado no header X-API-Key. NUNCA logado,
# NUNCA exposto ao front-end, NUNCA usado nesta rodada de implementacao
# (nenhuma chamada real/paga autorizada ainda).
VIO_API_BR_BASE_URL=https://vio.api.br
VIO_API_BR_API_KEY=

# Dias de validade do cache local (VIO_CACHE) de CNH/CRLV ja validados pela
# vio.api.br — TTL inicial de 7 dias (sensivelmente menor que os 30 dias de
# retencao do fornecedor), decisao explicita do usuario. Um cache-hit NUNCA
# executa nova comparacao OCR no fornecedor — a supervisao fisica humana no
# totem + este TTL curto sao os controles operacionais aceitos para esse
# risco residual. Qualquer ampliacao futura deste valor exige nova decisao
# explicita do usuario, nunca alterada por otimizacao de custo isolada.
VIO_API_BR_CACHE_TTL_DIAS=7

# Chave HMAC-SHA256 (hex, 64 chars) usada SOMENTE para o fingerprint do cache
# desta nova integracao — SEPARADA tanto de DOCUMENTO_QR_HMAC_KEY (cache do
# fluxo antigo Serpro) quanto de DOCUMENTO_DATA_KEY (criptografia de dado em
# repouso), blast radius proprio. Nome versionado (_V1) para permitir
# rotacao sem invalidar em massa: ao rotacionar, defina
# VIO_API_BR_CACHE_HMAC_KEY_V2 (nunca reaproveite o nome/valor da versao
# anterior) e mude VIO_API_BR_CACHE_HMAC_VERSION para "2" — o cache gravado
# sob a versao antiga so para de receber hits novos e expira pelo TTL
# normal, nunca e migrado/reescrito automaticamente. Gerar com:
# php -r "echo bin2hex(random_bytes(32));"
VIO_API_BR_CACHE_HMAC_KEY_V1=
VIO_API_BR_CACHE_HMAC_VERSION=1

# Servico local de impressao (mini PC Windows do totem, EPSON TM-T88VII via
# USB, demanda impressao-etiqueta-teste, 2026-09-14) — servico Node.js
# implementado a parte (fora do escopo Hostgator/PHP), exposto so em
# 127.0.0.1 no mini PC. IMPRESSAO_LOCAL_URL e a base URL local (ex:
# http://127.0.0.1:PORTA), NUNCA um endereco publico. IMPRESSAO_LOCAL_TOKEN
# e o token compartilhado que o front-end do totem envia ao servico local
# (autenticacao propria, alem de CORS/PNA — recomendacao security-especialista
# no handoff de 00-planejamento), NUNCA commitado com valor real.
# Lidas pela classe compartilhada Util\ConfiguracaoServicoImpressao (desde a
# demanda impressao-arquitetura-producao-ux, 2026-09-15), consumida tanto
# por App\Controller\ImpressaoAtendimentoController::configuracaoServicoLocal()
# (fluxo REAL de producao, impressao.php) quanto por
# App\Controller\ImpressaoTesteController::configuracaoServicoLocal()
# (exclusivo da tela de diagnostico, impressao-teste.php) - ambas so apos
# Util\Auth::validarTotem().
IMPRESSAO_LOCAL_URL=
IMPRESSAO_LOCAL_TOKEN=

# IMPRESSORAS_PERMITIDAS e IMPRESSAO_TIMEOUT_MS sao espelhos de
# documentacao/operacao dos MESMOS valores configurados manualmente em
# servico-impressao-local/config/config.json no mini PC (campos
# "impressorasPermitidas"/"timeoutMs") -- mesmo padrao de espelhamento
# manual ja usado para o token acima: nao ha conexao viva entre o .env do
# Hostgator e o config.json do mini PC, o PHP nao le estas duas variaveis.
# IMPRESSAO_FRONTEND_TIMEOUT_MS E lida de fato pela mesma classe
# compartilhada Util\ConfiguracaoServicoImpressao (ver nota acima) e
# devolvida ao front-end (deve ser sempre maior que IMPRESSAO_TIMEOUT_MS/
# timeoutMs do servico local, para o front nao desistir antes do servico
# local ter chance de responder com o resultado do timeout dele).
IMPRESSORAS_PERMITIDAS="EPSON TM-T88VII Receipt"
IMPRESSAO_TIMEOUT_MS=30000
IMPRESSAO_FRONTEND_TIMEOUT_MS=35000

# Etiqueta (producao: ImpressaoAtendimentoController; diagnostico:
# ImpressaoTesteController) — largura/comprimento do PAPEL em MILIMETROS,
# orientacao (portrait|landscape) e corte apos impressao (true|false) SEMPRE
# configuraveis aqui, nunca hardcoded no codigo. Configuracao final decidida em
# 2026-10-02: papel 80x80 mm retrato (papel "totem" do driver EPSON). Falha
# fechada (sem default silencioso) se alguma das 4 variaveis estiver
# ausente/invalida. Sem segredos nestas variaveis.
ETIQUETA_LARGURA_MM=80
ETIQUETA_COMPRIMENTO_MM=80
ETIQUETA_ORIENTACAO=portrait
ETIQUETA_CORTE_APOS_IMPRESSAO=true
# (Opcional) Largura util do CONTEUDO da etiqueta, em mm, a partir de 1 mm da
# borda esquerda (a EPSON TM-T88VII corta em ~50,8 mm). Numerico entre 20 e a
# largura da pagina; ausente/invalido = 48. Nao altera o tamanho da pagina.
# ETIQUETA_AREA_UTIL_MM=48

# Validacao obrigatoria de numero_nota em atendimento.php?acao=concluir-
# digitalizacao (demanda hardening-revisao-notas-e-cliente, 2026-09-30,
# decisao D5). Ausente, vazia ou qualquer valor diferente do literal "true"
# = DESLIGADA
# (comportamento anterior, sem validacao de numero na conclusao). So o valor
# exato "true" liga: a conclusao passa a responder HTTP 422 com codigo
# NOTAS_SEM_NUMERO (dados: ordens_pendentes, total_notas, total_pendentes)
# se alguma nota ativa nao tiver numero valido (1 a 9 digitos, sem zero a
# esquerda), sem alterar etapa nem cliente. Ligar SOMENTE depois de o
# front-end novo (revisao com tratamento do 422) estar no ar e confirmado no
# totem -- uma aba antiga nao sabe tratar o 422.
CONCLUIR_EXIGE_NUMERO_NOTA=false

# Anexo da Ordem de Coleta (OC) enviado pelo n8n (demanda
# anexo-ordem-coleta-n8n, 2026-10-05) — rota server-to-server
# public/api/ordem-coleta-anexo.php (POST, JSON com base64). Os PDFs ficam em
# STORAGE_PATH/ordens_coleta/<cnpj>/ (fora do docroot; pastas 0750, arquivos
# 0640) e o cron cron/limpar-anexos-ordem-coleta.php aplica a retencao.
#
# ORDEM_COLETA_ANEXO_API_KEY: chave que o n8n envia em
# "Authorization: Bearer <chave>". SEGREDO — nunca commitar valor real, nunca
# logar, nunca reaproveitar de outra variavel (token de totem, Talent, VIO,
# impressao). Ausente/vazia = a rota responde 503 (fail-closed). Gerar com:
# php -r "echo bin2hex(random_bytes(32));"
# Em caso de exposicao, rotacionar no .env e no n8n ao mesmo tempo.
ORDEM_COLETA_ANEXO_API_KEY=
# Tamanho maximo, em BYTES, do PDF DECODIFICADO. Padrao: 5242880 (5 MB); sem a
# variavel o codigo usa o mesmo padrao.
ORDEM_COLETA_ANEXO_MAX_BYTES=5242880
# (Opcional, SOMENTE desenvolvimento local) permitir HTTP na rota acima. Em
# producao a rota exige HTTPS; NAO definir em producao (ausente = HTTPS
# obrigatorio).
# ORDEM_COLETA_ANEXO_PERMITIR_HTTP=true
