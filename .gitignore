# Ambiente / segredos
.env
!.env.example

# Dependências (regeneradas via `composer install` no servidor — ver docs/deploy-checklist.md)
/vendor/

# Dados reais capturados/cacheados pelo totem (LGPD e dados de terceiro —
# nunca versionar documentos/fotos reais nem cache de clientes da carteira
# UDLOG). Estrutura de pastas não precisa de .gitkeep: UploadHelper::
# salvarImagemBase64 e ClienteApiClient criam os diretórios dinamicamente
# via mkdir recursivo.
storage/

# Evidências de teste/debug com dados reais de documentos
docs/evidencias-scanner/

# Lixo acidental
composer copy.json

# SO
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Dumps de banco externo com dado sensível (hash de token de API de
# produção, IPs reais) — nunca versionar
/docs/udlogo59_db_gestao_coletas.sql

# Scripts de teste manual descartáveis/de uso pontual (prefixo "_" em
# tests/manual/) — costumam bypassar a idempotência local para exercitar
# chamadas HTTP reais a APIs externas (ex: Talent) e nunca devem ser
# versionados, mesmo sem dado pessoal explícito no próprio arquivo
tests/manual/_*.php

# Ferramentas de IA (Claude Code): agentes, comandos, skills, configuracao,
# instrucoes do projeto, contratos de comunicacao, estado do projeto (resumido
# e backup completo) e documentacao/handoffs de trabalho. Ficam apenas na
# maquina de desenvolvimento e nunca sao versionados.
.claude/
CLAUDE.md
docs/
ia_development_state.md
ia_development_state_bkp.md

# Fotos reais de notas fiscais usadas em diagnostico de OCR (dado pessoal/de
# terceiros, LGPD) — nunca versionar. A pasta permanece no disco local.
/testeOcr/

# Fixtures de teste: nada em tests/fixtures/ e versionado (fotos de documentos
# reais contem dado pessoal; os testes geram imagens sinteticas em memoria).
tests/fixtures/*

# Imagens de exemplo locais (CNH/CRLV podem conter dado pessoal) e material
# de referencia da impressora — nunca versionar.
exemplos/
epson/
